# Copier ce fichier en .env puis adapter les valeurs.
# Le fichier .env contient des secrets : il n'est JAMAIS versionné (voir .gitignore).

APP_ENV=dev
APP_URL=http://localhost:8090

# MySQL
DB_HOST=mysql
DB_PORT=3306
DB_NAME=fantasyrealm
DB_USER=fantasyrealm
DB_PASSWORD=change-moi
DB_ROOT_PASSWORD=change-moi-root

# MongoDB
MONGO_URI=mongodb://mongo:27017
MONGO_DB=fantasyrealm

# E-mails (Mailpit en local ; en production : SMTP de l'hébergeur avec MAIL_USER / MAIL_PASSWORD)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@fantasyrealm.local
MAIL_CONTACT=contact@pixelverse-studios.local
