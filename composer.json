{
    "name": "pixelverse/fantasyrealm-personnages",
    "description": "FantasyRealm Online - système de gestion de personnages (ECF Développeur Web et Web Mobile)",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "ext-mongodb": "*",
        "vlucas/phpdotenv": "^5.6",
        "mongodb/mongodb": "^2.1",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": ["src/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
